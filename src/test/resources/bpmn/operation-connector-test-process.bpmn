<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_jsonschema"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="hand-authored"
                  exporterVersion="1"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="json-schema-validator-test-process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_start_to_validate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ValidateTask" name="Validate"
                      zeebe:modelerTemplate="io.camunda.connector.json-schema-validator.v1"
                      zeebe:modelerTemplateVersion="1">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:json-schema-validator:1" retries="1" />
        <zeebe:taskHeaders>
          <zeebe:header key="operation" value="validate" />
          <zeebe:header key="elementTemplateVersion" value="1" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connector.json-schema-validator.v1" />
          <zeebe:header key="resultVariable" value="validationResult" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=data" target="data" />
          <zeebe:input source="inline" target="schemaSource" />
          <zeebe:input source="=schema" target="schema" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_validate</bpmn:incoming>
      <bpmn:outgoing>Flow_validate_to_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_start_to_validate" sourceRef="StartEvent_1" targetRef="ValidateTask" />
    <bpmn:exclusiveGateway id="IsValidGw" name="valid?" default="Flow_gw_to_invalid">
      <bpmn:incoming>Flow_validate_to_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_to_ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_to_invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_validate_to_gw" sourceRef="ValidateTask" targetRef="IsValidGw" />
    <bpmn:sequenceFlow id="Flow_gw_to_ok" sourceRef="IsValidGw" targetRef="OkEnd">
      <bpmn:conditionExpression>=validationResult.valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_to_invalid" sourceRef="IsValidGw" targetRef="ValidationFailedEnd" />
    <bpmn:endEvent id="OkEnd" name="Ok">
      <bpmn:incoming>Flow_gw_to_ok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ValidationFailedEnd" name="Validation Failed">
      <bpmn:incoming>Flow_gw_to_invalid</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="json-schema-validator-test-process">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ValidateTask_di" bpmnElement="ValidateTask">
        <dc:Bounds x="260" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IsValidGw_di" bpmnElement="IsValidGw" isMarkerVisible="true">
        <dc:Bounds x="410" y="93" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OkEnd_di" bpmnElement="OkEnd">
        <dc:Bounds x="520" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ValidationFailedEnd_di" bpmnElement="ValidationFailedEnd">
        <dc:Bounds x="417" y="220" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_to_validate_di" bpmnElement="Flow_start_to_validate">
        <di:waypoint x="216" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_validate_to_gw_di" bpmnElement="Flow_validate_to_gw">
        <di:waypoint x="360" y="118" />
        <di:waypoint x="410" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_gw_to_ok_di" bpmnElement="Flow_gw_to_ok">
        <di:waypoint x="460" y="118" />
        <di:waypoint x="520" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_gw_to_invalid_di" bpmnElement="Flow_gw_to_invalid">
        <di:waypoint x="435" y="143" />
        <di:waypoint x="435" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
